{
    "name": "piston-test",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "forwardPorts": [2000],
    "portsAttributes": {
        "2000": {
            "label": "Piston API",
            "onAutoForward": "notify"
        }
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-json"
            ]
        }
    }
}
